# Server Mode Configuration
# 服务端模式配置
# Set to 'true' to enable server mode (Options: true, false)
# 设置为 'true' 启用服务端模式（选项：true, false）
NUXT_PUBLIC_SERVER_MODE=false

# AI Provider Configuration (used in server mode)
# AI 提供商配置（服务端模式使用）
# ---
# Available providers: openai-compatible, siliconflow, 302-ai, infiniai, openrouter, requesty, deepseek, ollama, litellm
# 可用提供商：openai-compatible, siliconflow, 302-ai, infiniai, openrouter, requesty, deepseek, ollama, litellm
NUXT_PUBLIC_AI_PROVIDER=openai-compatible
# AI model name (e.g. gpt-4o-mini, deepseek-chat, etc.)
# AI 模型名称（如 gpt-4o-mini, deepseek-chat 等）
NUXT_PUBLIC_AI_MODEL=gpt-4o-mini
# Maximum context size for the AI model
# AI 模型的最大上下文长度
NUXT_PUBLIC_AI_CONTEXT_SIZE=128000
# AI provider API key (server-side only, not exposed to frontend)
# AI 提供商 API 密钥（仅服务端使用，不暴露给前端）
NUXT_AI_API_KEY=your-api-key-here
# AI provider API base URL (optional, uses provider default if not set)
# AI 提供商 API 基础 URL（可选，未设置时使用提供商默认值）
NUXT_AI_API_BASE=https://api.openai.com/v1

# Web Search Provider Configuration (used in server mode)
# 网页搜索提供商配置（服务端模式使用）
# ---
# Available providers: tavily, firecrawl, crw, google-pse, youcom, parallel (server mode only)
# 可用提供商：tavily, firecrawl, crw, google-pse, youcom, parallel（仅服务端模式）
NUXT_PUBLIC_WEB_SEARCH_PROVIDER=tavily
# Maximum number of concurrent search requests (1-5 recommended)
# 最大并发搜索请求数（建议 1-5）
NUXT_PUBLIC_WEB_SEARCH_CONCURRENCY_LIMIT=2
# Search language (Options: en, zh, nl)
# 搜索语言（选项：en, zh, nl）
NUXT_PUBLIC_WEB_SEARCH_SEARCH_LANGUAGE=en
# Enable Tavily advanced search (Options: true, false)
# 启用 Tavily 高级搜索（选项：true, false）
NUXT_PUBLIC_TAVILY_ADVANCED_SEARCH=false
# Tavily search topic (Options: general, news, finance)
# Tavily 搜索主题（选项：general, news, finance）
NUXT_PUBLIC_TAVILY_SEARCH_TOPIC=general
# Google Programmable Search Engine ID (required for google-pse provider)
# Google 可编程搜索引擎 ID（提供商为 google-pse 时必填）
NUXT_PUBLIC_GOOGLE_PSE_ID=your-google-pse-id
# Web search provider API key (server-side only, not exposed to frontend)
# For Tavily and Google PSE, you can provide multiple keys separated by commas for automatic polling.
# For youcom, the key is optional: without a key the keyless endpoint (limited daily quota) is used.
# Parallel uses the anonymous free Search MCP; this key and API base are unused.
# 网页搜索提供商 API 密钥（仅服务端使用，不暴露给前端）
# 对于 Tavily 和 Google PSE，你可以提供多个由逗号分隔的密钥，以启用自动轮询功能。
# 对于 youcom，密钥为可选：未设置时使用免密钥端点（每日配额有限）。
# Parallel 使用匿名免费 Search MCP，不使用此密钥与 API 基础 URL。
NUXT_WEB_SEARCH_API_KEY=your-key-1,your-key-2
# Web search provider API base URL (optional, for firecrawl/crw self-hosted)
# crw defaults to the cloud base https://fastcrw.com/api; set this to your self-hosted server.
# 网页搜索提供商 API 基础 URL（可选，用于 firecrawl/crw 自托管）
# crw 默认使用云端地址 https://fastcrw.com/api；自托管时请设置为你的服务器地址。
NUXT_WEB_SEARCH_API_BASE=

# Outbound proxy (server mode only, optional)
# 出站代理（仅服务端模式，可选）
# ---
# Supported schemes: http, https, socks5, socks5h, socks
# 支持的协议：http, https, socks5, socks5h, socks
# http(s) proxies cover AI + Google PSE + you.com + Parallel + Tavily/Firecrawl SDKs.
# socks* proxies cover AI + Google PSE + you.com + Parallel (axios SDKs cannot speak SOCKS).
# http(s) 代理全覆盖；socks* 代理只覆盖 AI、Google PSE、you.com 与 Parallel（axios SDK 不支持 SOCKS）。
# URL-encode special characters in credentials (% as %25, @ as %40, : as %3A).
# 凭证中的特殊字符需 URL 编码（% 写成 %25、@ 写成 %40、: 写成 %3A）。
NUXT_PROXY_URL=
# Hosts bypassing the proxy (default when NUXT_PROXY_URL is set: localhost,127.0.0.1,::1)
# 不走代理的主机（设置 NUXT_PROXY_URL 后默认值：localhost,127.0.0.1,::1）
NUXT_NO_PROXY=localhost,127.0.0.1,::1
